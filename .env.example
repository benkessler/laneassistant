# Lane Assistant configuration. Copy to .env and fill in the values.

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://laneassistant:laneassistant_dev@localhost:5432/laneassistant
POSTGRES_PASSWORD=laneassistant_dev

# ─── Redis (optional for single-instance) ────────────────
REDIS_URL=redis://localhost:6379

# ─── Slack ───────────────────────────────────────────────
# Create the app from slack-app-manifest.yml at https://api.slack.com/apps
# Enable Socket Mode and create an App-Level Token (xapp-...) with connections:write
# Install to your workspace and copy the Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ─── Model ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
DEFAULT_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=high
MAX_TOKENS=16000

# Optional alternative providers
# OPENAI_API_KEY=sk-your-key
# GOOGLE_AI_API_KEY=your-key
# Local models: DEFAULT_MODEL=ollama/<model-name>
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Dashboard ───────────────────────────────────────────
# Served by the bot at http://localhost:3001. At least 12 characters.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# ENABLE_DASHBOARD=true

# ─── Application ─────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ─── Limits ──────────────────────────────────────────────
MAX_CONCURRENT_RUNS=16
TOOL_TIMEOUT_MS=600000
AGENT_TIMEOUT_MS=300000

# ─── Tool Backend ────────────────────────────────────────
# "local" runs agent commands on this machine; "modal" runs them in isolated
# Modal sandboxes. Use "modal" before giving the agent access to client data.
TOOL_BACKEND=local
# MODAL_ENDPOINT_URL=https://your-modal-app--execute.modal.run
# MODAL_AUTH_TOKEN=your-modal-auth-token

# Secret used to sign per-workspace tool-gateway tokens. Random per process if
# unset; set it only when several bot processes must accept each other's tokens.
# TOOL_TOKEN_SECRET=

# ─── Cron Scheduler ─────────────────────────────────────
# CRON_CHECK_INTERVAL_MS=30000
# HEARTBEAT_ENABLED=true

# ─── Integrations: Pipedream Connect (optional) ──────────
# Connects Gmail, Google Calendar, HubSpot, Sheets and ~3,000 other apps.
# Sign up at https://pipedream.com/connect; all three must be set together.
# PIPEDREAM_CLIENT_ID=your-client-id
# PIPEDREAM_CLIENT_SECRET=your-client-secret
# PIPEDREAM_PROJECT_ID=your-project-id
# PIPEDREAM_ENVIRONMENT=development

# ─── Browser automation: Browserbase (optional) ──────────
# BROWSERBASE_API_KEY=bb_live_your-key

# ─── Permissions ────────────────────────────────────────
# Skips the Slack approval step for actions that change external systems.
# Keep this false whenever client data or client-facing actions are involved.
# DANGEROUSLY_SKIP_PERMISSIONS=false
